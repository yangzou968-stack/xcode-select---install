<?xml version="1.0" encoding="utf-8"?>
<!--
    开示结果面板 — 上半屏半透明浮层
    · 显示三段式师父回复（悲悯共情/因果开示/法药指引）
    · 一键复制整段开示
    · 半透明设计，不遮挡聊天内容
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E6F5F0EB"
    android:padding="14dp"
    android:elevation="8dp">

    <!-- 标题 + 来源标注 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="觉心开示"
            android:textColor="#8B4513"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#999"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_close_result"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="✕"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:textColor="#666"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- 状态提示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#888"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 悲悯共情 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAFFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悲悯共情"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_compassion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#333"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/btn_copy_compassion"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="复制此段"
                        android:textSize="11sp"
                        android:textColor="#8B4513"
                        android:background="@drawable/btn_outline_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 因果开示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAFFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="因果开示"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_karma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#333"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/btn_copy_karma"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="复制此段"
                        android:textSize="11sp"
                        android:textColor="#8B4513"
                        android:background="@drawable/btn_outline_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 法药指引 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAFFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="法药指引"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#333"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/btn_copy_action"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="复制此段"
                        android:textSize="11sp"
                        android:textColor="#8B4513"
                        android:background="@drawable/btn_outline_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_regenerate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="重新生成"
            android:textSize="13sp"
            android:textColor="#8B4513"
            android:background="@drawable/btn_outline_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/btn_copy_all"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="复制全文"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary_bg" />
    </LinearLayout>

</LinearLayout>
